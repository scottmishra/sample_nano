# NanoClaw Environment Variables
# Copy to .env and fill in your values

# Brave Search API key (get at https://search.brave.com/api)
BRAVE_API_KEY=

# Azure MCP option — uncomment ONE:
# AZURE_MCP_OPTION=A   # Official @azure/mcp (recommended)
# AZURE_MCP_OPTION=B   # jdubois/azure-cli-mcp JAR (needs Java 17+)
# AZURE_MCP_OPTION=C   # Docker-based (best SOC 2 isolation)

# For Option B only — path to the downloaded JAR
# AZURE_CLI_MCP_JAR=/path/to/azure-cli-mcp.jar

# Azure DevOps defaults (optional — saves typing)
# AZDO_ORG=https://dev.azure.com/YOUR_ORG
# AZDO_PROJECT=YOUR_PROJECT
